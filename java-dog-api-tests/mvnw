# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script, version 3.3.2
# ----------------------------------------------------------------------------

set -e

MAVEN_WRAPPER_PROPERTIES_URL=".mvn/wrapper/maven-wrapper.properties"

DOWNLOAD_URL=
WRAPPER_JAR=".mvn/wrapper/maven-wrapper.jar"

if [ -f "$WRAPPER_JAR" ]; then
  exec java -classpath "$WRAPPER_JAR" org.apache.maven.wrapper.MavenWrapperMain "$@"
fi

if [ -z "$MAVEN_WRAPPER_PROPERTIES_URL" ]; then
  echo "maven-wrapper.properties not found"
  exit 1
fi

WRAPPER_URL=$(grep wrapperUrl "$MAVEN_WRAPPER_PROPERTIES_URL" | sed 's/.*=//')

echo "Downloading Maven Wrapper JAR..."
if command -v curl > /dev/null 2>&1; then
  curl -fsSL -o "$WRAPPER_JAR" "$WRAPPER_URL"
elif command -v wget > /dev/null 2>&1; then
  wget -q -O "$WRAPPER_JAR" "$WRAPPER_URL"
else
  echo "curl or wget required to download Maven Wrapper JAR"
  exit 1
fi

exec java -classpath "$WRAPPER_JAR" org.apache.maven.wrapper.MavenWrapperMain "$@"
